<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DADA Enterprise | Client Portal</title>
    <link rel="stylesheet" href="/style.css">

</head>
<body class="bg-background text-foreground min-h-screen font-sans flex flex-col">

    <header class="bg-primary text-primary-fg px-4 sm:px-6 py-4 flex flex-wrap justify-between items-center gap-4 shadow-md sticky top-0 z-50">
        <div class="flex items-center gap-2 sm:gap-4">
            <div class="w-8 h-8 bg-accent text-primary flex items-center justify-center font-bold rounded shadow-inner">D</div>
            <h1 class="text-lg sm:text-xl font-serif-custom tracking-wider font-semibold">DADA ENTERPRISE</h1>
            <span class="border border-white/20 bg-white/10 text-white text-[9px] sm:text-[10px] px-2 py-1 rounded-full ml-1 sm:ml-2 uppercase tracking-widest">Client Portal</span>
        </div>
        <div class="flex items-center gap-3 sm:gap-4">
            <span class="text-xs sm:text-sm opacity-80 hidden sm:block">Welcome back, <strong><%= user.user_name %> (<%= user.company_name %>)</strong></span>
            <a href="/logout" class="text-xs sm:text-sm font-medium hover:text-accent transition">🚪 Logout</a>
        </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
        
        <div class="flex gap-2 border-b border-border mb-8 overflow-x-auto whitespace-nowrap pb-1">
            <button onclick="switchTab('order')" id="tab-btn-order" class="px-6 py-3 border-b-2 border-primary font-bold text-primary transition rounded-t">
                🛒 Place Bulk Order
            </button>
            <button onclick="switchTab('history')" id="tab-btn-history" class="px-6 py-3 border-b-2 border-transparent text-muted-fg hover:text-foreground transition rounded-t">
                📦 Order History
            </button>
            <button onclick="switchTab('reports')" id="tab-btn-reports" class="px-6 py-3 border-b-2 border-transparent text-muted-fg hover:text-foreground transition rounded-t">
                📊 Reports
            </button>
        </div>

        <div id="section-order" class="space-y-6">
            <form action="/customer/place-order" method="POST" class="bg-card rounded-xl border border-border p-6 md:p-8 shadow-sm">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h3 class="text-lg font-serif-custom font-bold text-foreground">Bulk Order Matrix</h3>
                        <p class="text-sm text-muted-fg mt-1">Enter quantities for any branch. Leave blank if a branch doesn't need a product today.</p>
                    </div>
                    <button type="button" onclick="document.getElementById('branchModal').classList.remove('hidden')" class="text-sm font-medium text-primary hover:text-accent transition flex items-center gap-1 bg-primary/10 px-4 py-2 rounded-lg">
                        + Register New Branch
                    </button>
                </div>

                <!-- Date Selector & AI Quick-Fill for the Order -->
                <div class="mb-6 flex flex-wrap gap-4 items-end justify-between">
                    <div class="w-full sm:w-auto">
                        <label for="order_date" class="block text-xs font-bold uppercase tracking-wider text-muted-fg mb-2">Delivery Date</label>
                        <input type="date" 
                               id="order_date" 
                               name="order_date" 
                               class="bg-[#fcfaf7] border border-border/80 focus:border-[#c8a96e] focus:ring-1 focus:ring-[#c8a96e] rounded-xl px-4 py-3 outline-none transition font-semibold text-foreground text-sm w-full sm:w-48 shadow-sm"
                               required>
                    </div>

                    <!-- AI Auto-Fill Trigger Button -->
                    <button type="button" onclick="openAiOrderModal()" class="bg-gradient-to-r from-amber-500 via-amber-600 to-amber-700 hover:from-amber-600 hover:to-amber-800 text-white font-semibold text-sm px-5 py-3 rounded-xl shadow-md hover:shadow-lg flex items-center gap-2.5 transition-all transform hover:scale-[1.02] active:scale-[0.98]">
                        <span class="text-lg">✨</span>
                        <span>AI Quick-Fill Order</span>
                        <span class="text-[11px] bg-white/20 px-2 py-0.5 rounded-full font-normal hidden sm:inline-block">Photo / Voice / WhatsApp</span>
                    </button>
                </div>
                <% if (branches && branches.length > 0 && products && products.length > 0) { %>
                    <div class="overflow-x-auto no-scrollbar border border-border rounded-lg bg-background">
                        <table class="w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-muted text-muted-fg uppercase tracking-wider text-xs border-b border-border">
                                <tr>
                                    <th class="p-4 font-bold sticky left-0 bg-muted border-r border-border z-10 w-56">Delivery Branch</th>
                                    <% products.forEach(product => { %>
                                        <% const finalPrice = Math.round(parseFloat(product.base_rate) * (1 + (parseFloat(product.gst_percentage) || 0) / 100)); %>
                                        <th class="p-4 font-bold min-w-[140px]">
                                            <div class="flex flex-col">
                                                <span class="text-foreground text-sm"><%= product.name %></span>
                                                <span class="text-[10px] lowercase opacity-80 font-normal">₹<%= finalPrice %> / <%= product.unit %></span>
                                            </div>
                                        </th>
                                    <% }) %>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border">
                                <% branches.forEach(branch => { %>
                                    <tr class="hover:bg-muted/20 transition group">
                                        <td class="p-4 sticky left-0 bg-background group-hover:bg-muted/50 border-r border-border z-10">
                                            <div class="flex items-center justify-between">
                                                <span class="font-bold"><%= branch.branch_name %></span>
                                                <button type="button" onclick="deleteBranch('<%= branch.id || branch.branch_id %>', '<%= branch.branch_name %>')" title="Remove Branch" class="flex-shrink-0 ml-2 opacity-0 group-hover:opacity-100 text-muted-fg hover:text-red-500 hover:bg-red-50 transition p-1.5 rounded-md flex items-center justify-center">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M3 6h18"></path>
                                                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                                                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                                                    </svg>
                                                </button>
                                            </div>
                                        </td>
                                        <% products.forEach(product => { %>
                                            <td class="p-3">
                                                <div class="flex items-end gap-1">
                                                    <input type="text" inputmode="decimal" name="orders[b_<%= branch.id || branch.branch_id %>][p_<%= product.id %>]" placeholder="-" class="w-full bg-input border border-border focus:border-primary rounded px-3 py-2 outline-none transition font-mono text-base" oninput="this.value = this.value.replace(/[^0-9.]/g, '')" autocomplete="off">
                                                </div>
                                            </td>
                                        <% }) %>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-8 flex justify-end pt-6 border-t border-border">
                        <button type="submit" class="bg-primary hover:bg-primary/90 text-primary-fg px-8 py-3 rounded font-medium text-lg transition shadow-lg flex items-center gap-2">
                            🛒 Submit Bulk Order
                        </button>
                    </div>
                <% } else { %>
                    <div class="text-center py-12 border-2 border-dashed border-border rounded-lg bg-muted/10">
                        <p class="text-muted-fg font-medium">Please add at least one branch to view the order matrix.</p>
                    </div>
                <% } %>
            </form>
        </div>

        <div id="section-history" class="hidden">
            <div class="bg-card rounded-xl border border-border overflow-x-auto shadow-sm">
                <table class="w-full text-left text-sm min-w-[700px] md:min-w-0">
                    <thead class="bg-primary text-primary-fg">
                        <tr>
                            <th class="p-4 font-medium tracking-wider">Order ID</th>
                            <th class="p-4 font-medium tracking-wider">Branches</th>
                            <th class="p-4 font-medium tracking-wider">Date</th>
                            <th class="p-4 font-medium tracking-wider">Status</th>
                            <th class="p-4 font-medium tracking-wider text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        <% if (orders && orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                                <tr class="hover:bg-muted/20 transition">
                                    <td class="p-4 font-mono font-bold">ORD-<%= String(order.id).padStart(4, '0') %></td>
                                    <td class="p-4"><%= order.branch_names %></td>
                                    <td class="p-4"><%= new Date(order.created_at).toLocaleDateString() %></td>
                                    <td class="p-4">
                                        <% if (order.status === 'Fulfilled') { %>
                                            <span class="px-3 py-1 bg-green-100 text-green-800 border border-green-200 rounded-full text-xs font-bold">✔ Fulfilled</span>
                                        <% } else { %>
                                            <span class="px-3 py-1 bg-yellow-100 text-yellow-800 border border-yellow-200 rounded-full text-xs font-bold"><%= order.status %></span>
                                        <% } %>
                                    </td>
                                    <td class="p-4 text-right flex justify-end gap-2">
                                        <button onclick="viewOrderDetails('<%= order.id %>')" class="text-primary hover:text-accent font-medium text-sm border border-primary/20 hover:border-accent bg-primary/5 px-3 py-1.5 rounded transition">👁️ View Items</button>
                                        <% if (order.status !== 'Fulfilled') { %>
                                            <button onclick="editOrder('<%= order.id %>')" class="text-white hover:bg-accent/90 font-medium text-sm bg-accent px-3 py-1.5 rounded transition shadow-sm">✏️ Edit</button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="p-8 text-center text-muted-fg">No orders found.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div id="section-reports" class="hidden">
            <div class="bg-card rounded-xl border border-border p-6 md:p-8 shadow-sm max-w-2xl">
                <h3 class="text-xl font-serif-custom font-bold text-foreground mb-2">Generate Order Data</h3>
                <p class="text-sm text-muted-fg mb-8">Download your complete order history and itemized breakdowns for your internal accounting.</p>
                <form action="/dashboard/reports/generate" method="GET" target="_blank" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold text-muted-fg mb-2 uppercase tracking-wider">Start Date</label>
                            <input type="date" name="startDate" required class="w-full bg-input border border-border focus:border-primary rounded px-4 py-3 outline-none transition">
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-muted-fg mb-2 uppercase tracking-wider">End Date</label>
                            <input type="date" name="endDate" required class="w-full bg-input border border-border focus:border-primary rounded px-4 py-3 outline-none transition">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold text-muted-fg mb-2 uppercase tracking-wider">Filter by Branch (Optional)</label>
                            <select name="branchId" class="w-full bg-input border border-border focus:border-primary rounded px-4 py-3 outline-none transition appearance-none">
                                <option value="ALL">All Branches</option>
                                <% if (branches) { branches.forEach(branch => { %>
                                    <option value="<%= branch.id %>"><%= branch.branch_name %></option>
                                <% }) } %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-muted-fg mb-2 uppercase tracking-wider">Report Type</label>
                            <select name="reportType" required class="w-full bg-input border border-border focus:border-primary rounded px-4 py-3 outline-none transition appearance-none">
                                <option value="tofu">Tofu (Hard Paneer)</option>
                                <option value="dairy">Dairy Products</option>
                            </select>
                        </div>
                    </div>
                    <div class="pt-4">
                        <button type="submit" class="w-full bg-foreground hover:bg-black text-background font-medium py-3 rounded transition shadow flex justify-center items-center gap-2">⬇️ Download Report</button>
                    </div>
                </form>
            </div>
        </div>

    </main>

    <!-- Register New Branch Modal -->
    <div id="branchModal" class="fixed inset-0 bg-black/60 backdrop-blur-md z-50 hidden flex items-center justify-center p-4 transition-all duration-300">
        <div class="bg-card rounded-2xl max-w-md w-full shadow-[0_25px_60px_-15px_rgba(30,58,40,0.3)] overflow-hidden border border-[#c8a96e]/20 flex flex-col transform scale-100 transition-all duration-300">
            <div class="px-6 py-5 border-b border-border bg-gradient-to-r from-[#1e3a28]/5 via-[#1e3a28]/2 to-transparent flex justify-between items-center">
                <h3 class="text-lg font-bold text-foreground font-serif-custom tracking-wide">Register New Branch</h3>
                <button type="button" onclick="document.getElementById('branchModal').classList.add('hidden')" class="w-8 h-8 rounded-full flex items-center justify-center bg-muted/60 hover:bg-muted text-muted-fg hover:text-foreground transition-all duration-200 text-xl leading-none">&times;</button>
            </div>
            <form action="/customer/add-branch" method="POST" onsubmit="saveEnteredQuantities()" class="p-6 sm:p-8 space-y-5">
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-muted-fg mb-1.5 uppercase tracking-wider">Branch Name</label>
                        <input type="text" name="branch_name" required placeholder="e.g. Andheri West" class="w-full bg-[#fcfaf7] border border-border/80 focus:border-[#c8a96e] focus:ring-1 focus:ring-[#c8a96e] rounded-xl px-4 py-3 outline-none transition text-sm text-foreground placeholder:text-muted-fg/60">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-muted-fg mb-1.5 uppercase tracking-wider">Address</label>
                        <textarea name="address" rows="3" required placeholder="Enter complete delivery address" class="w-full bg-[#fcfaf7] border border-border/80 focus:border-[#c8a96e] focus:ring-1 focus:ring-[#c8a96e] rounded-xl px-4 py-3 outline-none transition text-sm text-foreground placeholder:text-muted-fg/60 leading-relaxed"></textarea>
                    </div>
                </div>
                <div class="pt-4 flex gap-3">
                    <button type="button" onclick="document.getElementById('branchModal').classList.add('hidden')" class="flex-1 px-4 py-3 border border-border text-foreground font-semibold rounded-xl hover:bg-muted/40 transition-all duration-200">Cancel</button>
                    <button type="submit" class="flex-1 px-4 py-3 bg-primary text-primary-fg font-semibold rounded-xl hover:bg-primary/95 transition-all duration-200 shadow-md hover:shadow-lg">Save Branch</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Master Purchase Order (Invoice) Modal -->
    <div id="invoiceModal" class="fixed inset-0 bg-black/60 backdrop-blur-md z-50 hidden flex items-center justify-center p-4 transition-all duration-300">
        <div class="bg-card rounded-2xl max-w-3xl w-full shadow-[0_25px_60px_-15px_rgba(30,58,40,0.3)] overflow-hidden border border-[#c8a96e]/20 flex flex-col max-h-[90vh] transform scale-100 transition-all duration-300">
            <!-- Header -->
            <div class="px-6 py-5 border-b border-border bg-gradient-to-r from-[#1e3a28]/5 via-[#1e3a28]/2 to-transparent flex justify-between items-center">
                <div>
                    <h3 class="text-xl font-bold text-foreground font-serif-custom tracking-wide">Master Purchase Order</h3>
                    <p id="modal-order-id" class="text-xs font-mono text-muted-fg mt-1"></p>
                </div>
                <button type="button" onclick="document.getElementById('invoiceModal').classList.add('hidden')" class="w-8 h-8 rounded-full flex items-center justify-center bg-muted/60 hover:bg-muted text-muted-fg hover:text-foreground transition-all duration-200 text-xl leading-none">&times;</button>
            </div>
            
            <!-- Body -->
            <div class="p-6 sm:p-8 overflow-y-auto space-y-6">
                <!-- Info Section -->
                <div class="flex flex-col sm:flex-row justify-between gap-4 bg-[#fcfaf7] border border-border/80 p-5 rounded-2xl shadow-sm">
                    <div>
                        <p class="text-[10px] text-muted-fg uppercase tracking-widest font-bold mb-1">Entity Details</p>
                        <p id="modal-branch-name" class="font-bold text-foreground text-base"></p>
                        <p id="modal-branch-address" class="text-sm text-muted-fg mt-1.5 leading-relaxed"></p>
                    </div>
                    <div class="text-left sm:text-right flex flex-col sm:items-end justify-between">
                        <div>
                            <p class="text-[10px] text-muted-fg uppercase tracking-widest font-bold mb-1">Order Status</p>
                            <div id="modal-status" class="mt-1"></div>
                        </div>
                    </div>
                </div>

                <!-- Table Section -->
                <div class="overflow-x-auto border border-border/80 rounded-2xl shadow-sm bg-background">
                    <table class="w-full text-left text-sm min-w-[550px] border-collapse">
                        <thead>
                            <tr class="bg-muted/50 border-b border-border/85">
                                <th class="py-3.5 px-4 font-bold text-xs uppercase tracking-wider text-muted-fg">Branch</th>
                                <th class="py-3.5 px-4 font-bold text-xs uppercase tracking-wider text-muted-fg">Product</th>
                                <th class="py-3.5 px-4 font-bold text-xs uppercase tracking-wider text-muted-fg text-center" id="modal-qty-header">Qty</th>
                                <th class="py-3.5 px-4 font-bold text-xs uppercase tracking-wider text-muted-fg text-right">Base Rate</th>
                                <th class="py-3.5 px-4 font-bold text-xs uppercase tracking-wider text-muted-fg text-right">Total (Incl. GST)</th>
                            </tr>
                        </thead>
                        <tbody id="modal-items-tbody" class="divide-y divide-border/60"></tbody>
                    </table>
                </div>

                <!-- Grand Total Card -->
                <div class="bg-gradient-to-r from-[#1e3a28] to-[#2d563c] text-white p-5 rounded-2xl flex justify-between items-center shadow-md">
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 bg-white/10 rounded-xl">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#c8a96e]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs text-white/70 uppercase tracking-widest font-semibold" id="modal-grand-total-label">Estimated Total Amount</p>
                            <p class="text-xs text-white/50">Includes all taxes and product GST margins</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <p id="modal-grand-total" class="text-3xl font-extrabold font-mono text-[#c8a96e] tracking-tight"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Order Modal -->
    <div id="editOrderModal" class="fixed inset-0 bg-black/60 backdrop-blur-md z-50 hidden flex items-center justify-center p-4 transition-all duration-300">
        <div class="bg-card rounded-2xl max-w-5xl w-full shadow-[0_25px_60px_-15px_rgba(30,58,40,0.3)] overflow-hidden border border-[#c8a96e]/20 flex flex-col max-h-[90vh] transform scale-100 transition-all duration-300">
            <div class="px-6 py-5 border-b border-border bg-gradient-to-r from-[#1e3a28]/5 via-[#1e3a28]/2 to-transparent flex justify-between items-center">
                <div>
                    <h3 class="text-xl font-bold text-foreground font-serif-custom tracking-wide">Edit Master Purchase Order</h3>
                    <p id="edit-modal-order-id" class="text-xs font-mono text-muted-fg mt-1"></p>
                </div>
                <button type="button" onclick="document.getElementById('editOrderModal').classList.add('hidden')" class="w-8 h-8 rounded-full flex items-center justify-center bg-muted/60 hover:bg-muted text-muted-fg hover:text-foreground transition-all duration-200 text-xl leading-none">&times;</button>
            </div>
            <form id="form-edit-order" action="" method="POST" class="flex-1 flex flex-col overflow-hidden">
                <div class="p-6 overflow-y-auto flex-1">
                    <div class="overflow-x-auto no-scrollbar border border-border/80 rounded-2xl bg-background shadow-sm">
                        <table class="w-full text-left text-sm whitespace-nowrap border-collapse">
                            <thead>
                                <tr class="bg-muted border-b border-border/80">
                                    <th class="p-4 font-bold text-xs uppercase tracking-wider text-muted-fg sticky left-0 bg-muted border-r border-border/60 z-10 w-56">Delivery Branch</th>
                                    <% products.forEach(product => { %>
                                        <th class="p-4 font-bold text-xs uppercase tracking-wider text-muted-fg min-w-[140px] text-center"><%= product.name %><br><span class="text-[10px] text-muted-fg/70 lowercase font-medium">(<%= product.unit %>)</span></th>
                                    <% }) %>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border/60">
                                <% branches.forEach(branch => { %>
                                    <tr class="hover:bg-muted/15 transition group">
                                        <td class="p-4 sticky left-0 bg-background group-hover:bg-muted/30 border-r border-border/60 z-10">
                                            <span class="font-bold text-foreground text-sm"><%= branch.branch_name %></span>
                                        </td>
                                        <% products.forEach(product => { %>
                                            <td class="p-3">
                                                <input type="text" 
                                                       inputmode="decimal" 
                                                       name="orders[b_<%= branch.id || branch.branch_id %>][p_<%= product.id %>]" 
                                                       id="edit_input_b_<%= branch.id || branch.branch_id %>_p_<%= product.id %>"
                                                       placeholder="-" 
                                                       class="w-full bg-[#fcfaf7] border border-border/80 focus:border-[#c8a96e] focus:ring-1 focus:ring-[#c8a96e] rounded-xl px-3 py-2.5 outline-none transition font-mono text-center text-sm font-semibold text-foreground placeholder:text-muted-fg/40 shadow-sm"
                                                       oninput="this.value = this.value.replace(/[^0-9.]/g, '')"
                                                       autocomplete="off">
                                            </td>
                                        <% }) %>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="px-6 py-5 border-t border-border/80 bg-muted/20 flex justify-end gap-3">
                    <button type="button" onclick="document.getElementById('editOrderModal').classList.add('hidden')" class="px-5 py-3 border border-border text-foreground font-semibold rounded-xl hover:bg-muted/40 transition-all duration-200">Cancel</button>
                    <button type="submit" class="px-6 py-3 bg-primary text-primary-fg font-semibold rounded-xl hover:bg-primary/95 transition-all duration-200 shadow-md hover:shadow-lg">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- AI QUICK-FILL MODAL -->
    <div id="aiOrderModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fade-in">
        <div class="bg-card w-full max-w-xl rounded-2xl shadow-2xl border border-border flex flex-col overflow-hidden max-h-[90vh]">
            <!-- Header -->
            <div class="p-5 border-b border-border bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <span class="text-2xl p-2 bg-amber-500/20 rounded-xl">✨</span>
                    <div>
                        <h3 class="font-bold text-lg text-foreground">AI Quick-Fill Order</h3>
                        <p class="text-xs text-muted-fg">Upload a delivery slip photo, paste WhatsApp text, or speak</p>
                    </div>
                </div>
                <button type="button" onclick="closeAiOrderModal()" class="w-8 h-8 rounded-full flex items-center justify-center bg-muted hover:bg-muted/80 text-muted-fg text-xl leading-none">&times;</button>
            </div>

            <!-- Mode Selector Tabs -->
            <div class="flex border-b border-border bg-muted/30 px-4 pt-2 gap-2 text-xs sm:text-sm font-semibold">
                <button type="button" id="ai-tab-photo" onclick="switchAiTab('photo')" class="px-3 sm:px-4 py-2.5 border-b-2 border-primary text-primary transition flex items-center gap-1.5">
                    📸 Slip Photo
                </button>
                <button type="button" id="ai-tab-text" onclick="switchAiTab('text')" class="px-3 sm:px-4 py-2.5 border-b-2 border-transparent text-muted-fg hover:text-foreground transition flex items-center gap-1.5">
                    💬 WhatsApp Text
                </button>
                <button type="button" id="ai-tab-voice" onclick="switchAiTab('voice')" class="px-3 sm:px-4 py-2.5 border-b-2 border-transparent text-muted-fg hover:text-foreground transition flex items-center gap-1.5">
                    🎙️ Voice Order
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 overflow-y-auto space-y-4">
                <!-- Tab 1: Photo Upload -->
                <div id="ai-pane-photo" class="space-y-3">
                    <label class="block text-xs font-bold uppercase tracking-wider text-muted-fg">Photo of slip / handwritten notes / WhatsApp screenshot</label>
                    <div class="border-2 border-dashed border-border hover:border-primary/60 transition rounded-xl p-6 text-center cursor-pointer bg-muted/10 relative" onclick="document.getElementById('ai-slip-file').click()">
                        <input type="file" id="ai-slip-file" accept="image/*" class="hidden" onchange="previewAiFile(this)">
                        <div id="ai-upload-placeholder">
                            <div class="text-4xl mb-2">📸</div>
                            <p class="text-sm font-semibold text-foreground">Click to choose slip photo</p>
                            <p class="text-xs text-muted-fg mt-1">Supports PNG, JPG, or camera photos</p>
                        </div>
                        <div id="ai-upload-preview" class="hidden flex flex-col items-center">
                            <img id="ai-preview-img" class="max-h-36 rounded-lg shadow-sm border border-border mb-2 object-contain" />
                            <span id="ai-preview-filename" class="text-xs font-mono text-muted-fg"></span>
                        </div>
                    </div>
                </div>

                <!-- Tab 2: WhatsApp Text -->
                <div id="ai-pane-text" class="hidden space-y-3">
                    <label class="block text-xs font-bold uppercase tracking-wider text-muted-fg">Paste WhatsApp text</label>
                    <textarea id="ai-order-text" rows="5" placeholder="Example:&#10;Adajan: 10kg tofu, 20 buttermilk&#10;Vesu: 5kg dahi, 10 taaza milk" class="w-full bg-[#fcfaf7] border border-border/80 focus:border-[#c8a96e] focus:ring-1 focus:ring-[#c8a96e] rounded-xl p-3 text-sm outline-none transition font-sans"></textarea>
                </div>

                <!-- Tab 3: Voice Note -->
                <div id="ai-pane-voice" class="hidden space-y-4 text-center py-4">
                    <div class="w-20 h-20 mx-auto rounded-full bg-amber-500/10 border-2 border-amber-500/30 flex items-center justify-center cursor-pointer transition-all transform hover:scale-105 active:scale-95 shadow-md" id="ai-mic-btn" onclick="toggleVoiceRecording()">
                        <span class="text-3xl" id="ai-mic-icon">🎙️</span>
                    </div>
                    <div>
                        <p id="ai-voice-status" class="text-sm font-semibold text-foreground">Tap microphone and speak</p>
                        <p class="text-xs text-muted-fg mt-1">Speak in Gujarati, Hindi, or English (e.g. &quot;Adajan ma 10 kilo tofu ane 20 chhas&quot;)</p>
                    </div>
                    <div id="ai-voice-transcript-box" class="hidden bg-muted/40 p-3 rounded-xl border border-border text-left">
                        <span class="text-[10px] uppercase font-bold text-muted-fg block mb-1">Transcript:</span>
                        <p id="ai-voice-transcript" class="text-xs text-foreground italic"></p>
                    </div>
                </div>

                <!-- Status Feedback -->
                <div id="ai-scan-status" class="hidden p-3 rounded-xl text-xs font-semibold"></div>
            </div>

            <!-- Footer -->
            <div class="p-4 border-t border-border bg-muted/20 flex justify-between items-center">
                <span class="text-xs text-muted-fg flex items-center gap-1">⚡ Powered by Gemini AI</span>
                <div class="flex gap-2">
                    <button type="button" onclick="closeAiOrderModal()" class="px-4 py-2 border border-border text-sm font-semibold rounded-xl hover:bg-muted transition">Cancel</button>
                    <button type="button" id="ai-scan-submit-btn" onclick="executeAiOrderScan()" class="px-5 py-2 bg-primary hover:bg-primary/90 text-primary-fg text-sm font-semibold rounded-xl transition shadow flex items-center gap-2">
                        <span id="ai-scan-btn-spinner" class="hidden animate-spin">⏳</span>
                        <span id="ai-scan-btn-text">✨ Scan &amp; Auto-Fill</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- FLOATING RAG AI CHAT WIDGET -->
    <div id="floating-chat-container" class="fixed bottom-6 right-6 z-40">
        <!-- Floating Toggle Button -->
        <button type="button" onclick="toggleRagChat()" class="bg-gradient-to-r from-primary to-accent hover:shadow-xl text-white font-bold p-3.5 rounded-full shadow-lg flex items-center gap-2 transition-all transform hover:scale-105 active:scale-95">
            <span class="text-xl">💬</span>
            <span class="text-xs pr-1 font-semibold hidden sm:inline">Ask Dada AI</span>
        </button>

        <!-- Chat Popup Card -->
        <div id="ragChatWindow" class="hidden fixed bottom-20 right-6 w-[90vw] sm:w-96 bg-card border border-border rounded-2xl shadow-2xl overflow-hidden flex flex-col z-50 max-h-[500px] h-[480px]">
            <!-- Header -->
            <div class="p-4 bg-primary text-primary-fg flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <div>
                        <h4 class="font-bold text-sm leading-tight">Dada AI Support</h4>
                        <p class="text-[10px] opacity-80">Instant answers on rates, HSN &amp; rules</p>
                    </div>
                </div>
                <button type="button" onclick="toggleRagChat()" class="text-primary-fg/80 hover:text-primary-fg text-xl leading-none">&times;</button>
            </div>

            <!-- Messages Area -->
            <div id="rag-messages-box" class="flex-1 p-4 overflow-y-auto space-y-3 bg-[#fdfbf7] text-xs">
                <div class="flex gap-2 items-start">
                    <span class="p-1.5 bg-amber-500/10 rounded-lg text-sm">🤖</span>
                    <div class="bg-white border border-border/80 p-3 rounded-2xl rounded-tl-none shadow-sm text-foreground max-w-[85%]">
                        Hello! Ask me anything about our dairy &amp; tofu products, GST rates, HSN codes, or delivery cutoff times.
                    </div>
                </div>
            </div>

            <!-- Quick Questions Pills -->
            <div class="px-3 py-2 bg-muted/30 border-t border-border/60 flex gap-1.5 overflow-x-auto no-scrollbar text-[11px]">
                <button type="button" onclick="sendQuickQuestion('What is the GST rate and HSN for Tofu?')" class="bg-white border border-border px-2.5 py-1 rounded-full text-muted-fg hover:text-foreground hover:border-primary transition whitespace-nowrap">
                    Tofu Rate &amp; GST
                </button>
                <button type="button" onclick="sendQuickQuestion('When is the daily order cutoff time?')" class="bg-white border border-border px-2.5 py-1 rounded-full text-muted-fg hover:text-foreground hover:border-primary transition whitespace-nowrap">
                    Cutoff Time
                </button>
                <button type="button" onclick="sendQuickQuestion('What locations do you deliver to?')" class="bg-white border border-border px-2.5 py-1 rounded-full text-muted-fg hover:text-foreground hover:border-primary transition whitespace-nowrap">
                    Branches
                </button>
            </div>

            <!-- Input Form -->
            <form id="rag-chat-form" onsubmit="handleRagSubmit(event)" class="p-3 border-t border-border bg-card flex gap-2">
                <input type="text" id="rag-chat-input" placeholder="Type your question..." autocomplete="off" class="flex-1 bg-input border border-border rounded-xl px-3 py-2 text-xs outline-none focus:border-primary text-foreground">
                <button type="submit" class="bg-primary hover:bg-primary/90 text-primary-fg px-3.5 py-2 rounded-xl text-xs font-bold transition shadow">
                    Send
                </button>
            </form>
        </div>
    </div>

    <script>
        // --- AI QUICK-FILL MODAL LOGIC ---
        let currentAiTab = 'photo';
        let speechRecognition = null;
        let isRecording = false;

        function openAiOrderModal() {
            document.getElementById('aiOrderModal').classList.remove('hidden');
            document.getElementById('ai-scan-status').classList.add('hidden');
        }

        function closeAiOrderModal() {
            document.getElementById('aiOrderModal').classList.add('hidden');
            if (isRecording && speechRecognition) {
                speechRecognition.stop();
            }
        }

        function switchAiTab(tab) {
            currentAiTab = tab;
            ['photo', 'text', 'voice'].forEach(t => {
                const pane = document.getElementById('ai-pane-' + t);
                const btn = document.getElementById('ai-tab-' + t);
                if (t === tab) {
                    pane.classList.remove('hidden');
                    btn.classList.add('border-primary', 'text-primary');
                    btn.classList.remove('border-transparent', 'text-muted-fg');
                } else {
                    pane.classList.add('hidden');
                    btn.classList.remove('border-primary', 'text-primary');
                    btn.classList.add('border-transparent', 'text-muted-fg');
                }
            });
        }

        function previewAiFile(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                document.getElementById('ai-preview-filename').innerText = file.name;
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        document.getElementById('ai-preview-img').src = e.target.result;
                        document.getElementById('ai-upload-preview').classList.remove('hidden');
                        document.getElementById('ai-upload-placeholder').classList.add('hidden');
                    };
                    reader.readAsDataURL(file);
                } else {
                    document.getElementById('ai-upload-preview').classList.remove('hidden');
                    document.getElementById('ai-upload-placeholder').classList.add('hidden');
                    document.getElementById('ai-preview-img').classList.add('hidden');
                }
            }
        }

        function toggleVoiceRecording() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Speech recognition is not supported in this browser. Please use Chrome, Edge, or upload an audio/slip file.");
                return;
            }

            if (!speechRecognition) {
                speechRecognition = new SpeechRecognition();
                speechRecognition.continuous = false;
                speechRecognition.interimResults = true;
                speechRecognition.lang = 'gu-IN, hi-IN, en-IN'; // Multi-lingual Indian speech

                speechRecognition.onstart = function() {
                    isRecording = true;
                    document.getElementById('ai-mic-btn').classList.add('animate-pulse', 'bg-red-500/20', 'border-red-500');
                    document.getElementById('ai-voice-status').innerText = "Listening... Speak your order now";
                    document.getElementById('ai-voice-status').classList.add('text-red-500');
                };

                speechRecognition.onresult = function(event) {
                    let transcript = '';
                    for (let i = event.resultIndex; i < event.results.length; ++i) {
                        transcript += event.results[i][0].transcript;
                    }
                    document.getElementById('ai-voice-transcript-box').classList.remove('hidden');
                    document.getElementById('ai-voice-transcript').innerText = transcript;
                };

                speechRecognition.onerror = function(event) {
                    console.error("Speech recognition error:", event.error);
                    isRecording = false;
                    document.getElementById('ai-mic-btn').classList.remove('animate-pulse', 'bg-red-500/20', 'border-red-500');
                    document.getElementById('ai-voice-status').innerText = "Microphone error. Tap to retry.";
                    document.getElementById('ai-voice-status').classList.remove('text-red-500');
                };

                speechRecognition.onend = function() {
                    isRecording = false;
                    document.getElementById('ai-mic-btn').classList.remove('animate-pulse', 'bg-red-500/20', 'border-red-500');
                    document.getElementById('ai-voice-status').innerText = "Recording finished. Tap to record again or click 'Scan & Auto-Fill'.";
                    document.getElementById('ai-voice-status').classList.remove('text-red-500');
                };
            }

            if (isRecording) {
                speechRecognition.stop();
            } else {
                speechRecognition.start();
            }
        }

        async function executeAiOrderScan() {
            const statusEl = document.getElementById('ai-scan-status');
            const btnSpinner = document.getElementById('ai-scan-btn-spinner');
            const btnText = document.getElementById('ai-scan-btn-text');

            statusEl.classList.add('hidden');
            statusEl.className = "p-3 rounded-xl text-xs font-semibold";

            const formData = new FormData();

            if (currentAiTab === 'photo') {
                const fileInput = document.getElementById('ai-slip-file');
                if (!fileInput.files || !fileInput.files[0]) {
                    statusEl.innerText = "Please select a photo of your slip first.";
                    statusEl.classList.add('bg-red-50', 'text-red-600', 'border', 'border-red-200');
                    statusEl.classList.remove('hidden');
                    return;
                }
                formData.append('slip_file', fileInput.files[0]);
            } else if (currentAiTab === 'text') {
                const textInput = document.getElementById('ai-order-text').value.trim();
                if (!textInput) {
                    statusEl.innerText = "Please paste your order message first.";
                    statusEl.classList.add('bg-red-50', 'text-red-600', 'border', 'border-red-200');
                    statusEl.classList.remove('hidden');
                    return;
                }
                formData.append('order_text', textInput);
            } else if (currentAiTab === 'voice') {
                const transcript = document.getElementById('ai-voice-transcript').innerText.trim();
                if (!transcript) {
                    statusEl.innerText = "Please speak an order first before scanning.";
                    statusEl.classList.add('bg-red-50', 'text-red-600', 'border', 'border-red-200');
                    statusEl.classList.remove('hidden');
                    return;
                }
                formData.append('order_text', transcript);
            }

            try {
                btnSpinner.classList.remove('hidden');
                btnText.innerText = "AI Processing...";
                document.getElementById('ai-scan-submit-btn').disabled = true;

                const response = await fetch('/api/ai/scan-order', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.error || "Failed to process order.");
                }

                if (!data.items || data.items.length === 0) {
                    statusEl.innerText = "AI could not detect any matching product or branch items. Please check and try again.";
                    statusEl.classList.add('bg-amber-50', 'text-amber-800', 'border', 'border-amber-200');
                    statusEl.classList.remove('hidden');
                    return;
                }

                // Auto-fill the input fields in the table!
                let filledCount = 0;
                data.items.forEach(item => {
                    const input = document.querySelector(`input[name="orders[b_${item.branch_id}][p_${item.product_id}]"]`);
                    if (input) {
                        input.value = item.quantity;
                        input.classList.add('ring-2', 'ring-emerald-500', 'bg-emerald-50');
                        setTimeout(() => {
                            input.classList.remove('ring-2', 'ring-emerald-500', 'bg-emerald-50');
                        }, 4000);
                        filledCount++;
                    }
                });

                statusEl.innerText = `✨ Success! Auto-filled ${filledCount} item(s) across your branches. Review the table and submit when ready!`;
                statusEl.classList.add('bg-emerald-50', 'text-emerald-700', 'border', 'border-emerald-200');
                statusEl.classList.remove('hidden');

                setTimeout(() => {
                    closeAiOrderModal();
                }, 1600);

            } catch (err) {
                console.error("AI Scan Error:", err);
                statusEl.innerText = "Error: " + err.message;
                statusEl.classList.add('bg-red-50', 'text-red-600', 'border', 'border-red-200');
                statusEl.classList.remove('hidden');
            } finally {
                btnSpinner.classList.add('hidden');
                btnText.innerText = "✨ Scan & Auto-Fill";
                document.getElementById('ai-scan-submit-btn').disabled = false;
            }
        }

        // --- RAG CHAT LOGIC ---
        const ragChatHistory = [];

        function toggleRagChat() {
            const chatWindow = document.getElementById('ragChatWindow');
            chatWindow.classList.toggle('hidden');
            if (!chatWindow.classList.contains('hidden')) {
                document.getElementById('rag-chat-input').focus();
            }
        }

        function sendQuickQuestion(questionText) {
            document.getElementById('rag-chat-input').value = questionText;
            document.getElementById('rag-chat-form').dispatchEvent(new Event('submit', { cancelable: true }));
        }

        async function handleRagSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('rag-chat-input');
            const message = input.value.trim();
            if (!message) return;

            const messagesBox = document.getElementById('rag-messages-box');

            // Render User Bubble
            const userBubble = document.createElement('div');
            userBubble.className = "flex gap-2 items-start justify-end";
            userBubble.innerHTML = `
                <div class="bg-primary text-primary-fg p-3 rounded-2xl rounded-tr-none shadow-sm max-w-[85%]">
                    ${message}
                </div>
            `;
            messagesBox.appendChild(userBubble);
            input.value = '';
            messagesBox.scrollTop = messagesBox.scrollHeight;

            // Render Temporary Typing Indicator
            const typingBubble = document.createElement('div');
            typingBubble.id = 'rag-typing-bubble';
            typingBubble.className = "flex gap-2 items-start";
            typingBubble.innerHTML = `
                <span class="p-1.5 bg-amber-500/10 rounded-lg text-sm">🤖</span>
                <div class="bg-white border border-border p-3 rounded-2xl rounded-tl-none text-muted-fg animate-pulse">
                    Thinking...
                </div>
            `;
            messagesBox.appendChild(typingBubble);
            messagesBox.scrollTop = messagesBox.scrollHeight;

            try {
                const response = await fetch('/api/ai/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message, history: ragChatHistory })
                });

                const data = await response.json();
                const typingEl = document.getElementById('rag-typing-bubble');
                if (typingEl) typingEl.remove();

                const botReply = data.reply || "Sorry, I could not process your query.";

                // Render Bot Reply
                const botBubble = document.createElement('div');
                botBubble.className = "flex gap-2 items-start";
                botBubble.innerHTML = `
                    <span class="p-1.5 bg-amber-500/10 rounded-lg text-sm">🤖</span>
                    <div class="bg-white border border-border/80 p-3 rounded-2xl rounded-tl-none shadow-sm text-foreground max-w-[85%] leading-relaxed">
                        ${botReply.replace(/\n/g, '<br>')}
                    </div>
                `;
                messagesBox.appendChild(botBubble);
                messagesBox.scrollTop = messagesBox.scrollHeight;

                // Update session history
                ragChatHistory.push({ role: 'user', content: message });
                ragChatHistory.push({ role: 'model', content: botReply });

            } catch (err) {
                console.error("Chat error:", err);
                const typingEl = document.getElementById('rag-typing-bubble');
                if (typingEl) typingEl.remove();
            }
        }

        function switchTab(tabId) {
            document.getElementById('section-order').classList.add('hidden');
            document.getElementById('section-history').classList.add('hidden');
            document.getElementById('section-reports').classList.add('hidden');
            ['order', 'history', 'reports'].forEach(id => {
                const btn = document.getElementById('tab-btn-' + id);
                btn.classList.remove('border-primary', 'text-primary', 'font-bold');
                btn.classList.add('border-transparent', 'text-muted-fg');
            });
            document.getElementById('section-' + tabId).classList.remove('hidden');
            const activeBtn = document.getElementById('tab-btn-' + tabId);
            activeBtn.classList.remove('border-transparent', 'text-muted-fg');
            activeBtn.classList.add('border-primary', 'text-primary', 'font-bold');
        }

        async function viewOrderDetails(orderId) {
            try {
                const response = await fetch(`/customer/order/${orderId}`);
                if (!response.ok) throw new Error("Failed to fetch order details");
                
                const data = await response.json();
                const order = data.order;
                const items = data.items;

                document.getElementById('modal-order-id').innerText = `ORD-${String(order.id).padStart(4, '0')} • ${new Date(order.created_at).toLocaleDateString()}`;
                document.getElementById('modal-branch-name').innerText = "Master Corporate Order";
                document.getElementById('modal-branch-address').innerText = "Multiple Delivery Locations";
                
                const isOrderFulfilled = order.status === 'Fulfilled';
                document.getElementById('modal-status').innerHTML = isOrderFulfilled 
                    ? `<span class="px-3 py-1 bg-green-100 text-green-800 border border-green-200 rounded-full text-xs font-bold">✔ Fulfilled</span>`
                    : `<span class="px-3 py-1 bg-yellow-100 text-yellow-800 border border-yellow-200 rounded-full text-xs font-bold">${order.status}</span>`;

                document.getElementById('modal-qty-header').innerText = isOrderFulfilled ? "Delivered Qty" : "Requested Qty";

                const tbody = document.getElementById('modal-items-tbody');
                tbody.innerHTML = ''; 
                let grandTotal = 0;

                items.forEach(item => {
                    const basePrice = parseFloat(item.rate_at_order);
                    const gstPercent = parseFloat(item.gst_at_order) || 0;
                    const priceWithGst = basePrice * (1 + (gstPercent / 100));
                    
                    const hasDeliveredQty = item.delivered_quantity !== null && item.delivered_quantity !== undefined;
                    
                    const activeQty = (isOrderFulfilled && hasDeliveredQty) ? parseFloat(item.delivered_quantity) : parseFloat(item.ordered_quantity);
                    
                    const rowTotal = priceWithGst * activeQty;
                    grandTotal += rowTotal;

                    const qtyDisplay = isOrderFulfilled 
                        ? `<span class="text-green-600 font-bold">${activeQty}</span>`
                        : `${activeQty}`;

                    const tr = document.createElement('tr');
                    tr.className = "hover:bg-muted/20 even:bg-[#fcfaf7]/50 transition border-b border-border/40";
                    tr.innerHTML = `
                        <td class="py-4 px-4 font-bold text-xs text-primary tracking-wide">${item.branch_name}</td>
                        <td class="py-4 px-4 font-medium text-foreground">${item.product_name} <span class="text-xs text-muted-fg ml-1">(${item.unit})</span></td>
                        <td class="py-4 px-4 text-center font-semibold font-mono">${qtyDisplay}</td>
                        <td class="py-4 px-4 text-right text-muted-fg font-medium font-mono">₹${basePrice.toFixed(2)}</td>
                        <td class="py-4 px-4 text-right font-bold font-mono text-primary">₹${rowTotal.toFixed(2)}</td>
                    `;
                    tbody.appendChild(tr);
                });

                document.getElementById('modal-grand-total-label').innerText = isOrderFulfilled ? "Final Invoice Total" : "Estimated Total Amount";
                document.getElementById('modal-grand-total').innerText = `₹${Math.round(grandTotal).toLocaleString()}`;
                document.getElementById('invoiceModal').classList.remove('hidden');
            } catch (error) {
                console.error("Error:", error);
                alert("Could not load order details.");
            }
        }

        async function editOrder(orderId) {
            try {
                const response = await fetch(`/customer/order/${orderId}`);
                if (!response.ok) throw new Error("Failed to fetch order details");
                
                const data = await response.json();
                const order = data.order;
                const items = data.items;

                if (order.status === 'Fulfilled') {
                    alert("This order is already fulfilled and cannot be edited.");
                    return;
                }

                document.getElementById('form-edit-order').action = `/customer/edit-order/${orderId}`;
                document.getElementById('edit-modal-order-id').innerText = `ORD-${String(order.id).padStart(4, '0')} • Edit requested quantities`;

                // Clear all input fields first
                const inputs = document.querySelectorAll('#form-edit-order input[type="text"]');
                inputs.forEach(input => input.value = '');

                // Populate inputs with ordered quantities
                items.forEach(item => {
                    const inputId = `edit_input_b_${item.branch_id}_p_${item.product_id}`;
                    const input = document.getElementById(inputId);
                    if (input) {
                        input.value = parseFloat(item.ordered_quantity) || '';
                    }
                });

                document.getElementById('editOrderModal').classList.remove('hidden');
            } catch (error) {
                console.error("Error loading order for edit:", error);
                alert("Could not load order for editing.");
            }
        }

        // NEW: Handles the invisible branch deletion cleanly
        async function deleteBranch(branchId, branchName) {
            if (confirm(`Are you sure you want to remove ${branchName}?`)) {
                try {
                    const response = await fetch(`/customer/delete-branch/${branchId}`, {
                        method: 'POST'
                    });
                    
                    if (response.ok) {
                        window.location.reload(); 
                    } else {
                        const errorMessage = await response.text();
                        alert(errorMessage || "Could not delete branch.");
                    }
                } catch (error) {
                    console.error("Error:", error);
                    alert("A network error occurred.");
                }
            }
        }

        // NEW: Saves current input quantities to sessionStorage before branch registration submission
        function saveEnteredQuantities() {
            const quantities = {};
            const inputs = document.querySelectorAll('#section-order input[type="text"]');
            inputs.forEach(input => {
                if (input.value) {
                    quantities[input.name] = input.value;
                }
            });
            sessionStorage.setItem('saved_order_quantities', JSON.stringify(quantities));
        }

        // NEW: Restores saved quantities from sessionStorage on DOM load
        document.addEventListener('DOMContentLoaded', () => {
            // Set default date to tomorrow in Kolkata timezone
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            const tomorrowStr = tomorrow.toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
            const dateInput = document.getElementById('order_date');
            if (dateInput) {
                dateInput.value = tomorrowStr;
            }

            const saved = sessionStorage.getItem('saved_order_quantities');
            if (saved) {
                try {
                    const quantities = JSON.parse(saved);
                    for (const [name, value] of Object.entries(quantities)) {
                        const input = document.querySelector(`#section-order input[name="${name}"]`);
                        if (input) {
                            input.value = value;
                        }
                    }
                } catch (e) {
                    console.error("Error restoring quantities:", e);
                }
                sessionStorage.removeItem('saved_order_quantities');
            }
        });
    </script>
</body>
</html>